#!/bin/bash

# omarchy:summary=Switch to another person's desktop, locking yours first
# omarchy:args=[NAME]

set -euo pipefail

# Their own desktop when they have one running, which asks their password (or,
# for a child's, a grown-up's) on its lock screen; otherwise the login screen.
# Either way the password is typed on their side of the switch, never here.

me=$(id -un)
mapfile -t others < <(omarchy-user-list | awk -v me="$me" '$1 != me { print $1 }')
name=${1:-}

if (( ${#others[@]} == 0 )); then
  echo "$(omarchy-i18n users.noOneElse)" >&2
  exit 1
fi
if [[ -z $name ]]; then
  name=$(gum choose --header "$(omarchy-i18n users.switchTo)" "${others[@]}") || exit 0
fi
if ! printf '%s\n' "${others[@]}" | grep -qx -- "$name"; then
  echo "There is no one else named $name." >&2
  exit 1
fi

# Locked before anything switches, so this desktop is never left open behind
# the other one.
omarchy-system-lock
for (( i = 0; i < 50; i++ )); do
  omarchy-hyprland-session-locked && break
  sleep 0.1
done
omarchy-hyprland-session-locked || { echo "Could not lock this desktop, so nothing was switched." >&2; exit 1; }

session=$(loginctl list-sessions --json=short | jq -r --arg user "$name" '.[] | select(.user == $user and .seat == "seat0" and .class == "user") | .session' | head -1)
if [[ -n $session ]]; then
  loginctl activate "$session"
else
  # SDDM puts a Wayland greeter on the current VT when it judges that VT free,
  # and it judges the one this desktop is on free, so the greeter fails on it.
  # Move to a VT no session holds first, which the active session may do.
  used=$(loginctl list-sessions --json=short | jq -r '.[].tty // empty')
  for (( vt = 2; vt <= 12; vt++ )); do
    grep -qx "tty$vt" <<<"$used" || break
  done
  busctl call org.freedesktop.login1 /org/freedesktop/login1/seat/seat0 org.freedesktop.login1.Seat SwitchTo u "$vt"
  busctl call org.freedesktop.DisplayManager /org/freedesktop/DisplayManager/Seat0 org.freedesktop.DisplayManager.Seat SwitchToGreeter
fi
