#!/bin/bash

# omarchy:hidden=true
# omarchy:summary=Provide the account, disk slot and journal functions behind omarchy-user-helper

if [[ ${BASH_SOURCE[0]} == "$0" ]]; then
  echo "omarchy-user-functions is an internal function library." >&2
  exit 64
fi

# Every account's password is also its own LUKS key slot on the system disk,
# recorded in the slot map so boot can tell who unlocked it (plans/users.md).
# Passwords live in variables and reach other programs on stdin or through
# process substitution, never argv; never trace them.

: "${USERS_DIR:=/etc/omarchy/users}"
: "${USERS_JOURNAL:=/var/lib/omarchy/users/journal}"
: "${USERS_LOCK:=/run/lock/omarchy-users.lock}"
: "${USERS_SHADOW:=/etc/shadow}"
: "${USERS_SUDOERS_DIR:=/etc/sudoers.d}"
: "${USERS_LIFECYCLE_DISPATCH:=/usr/bin/omarchy-lifecycle-dispatch}"
: "${USERS_REFUSAL_DELAY:=3}"

USERS_SLOT_MAP=$USERS_DIR/slots
USERS_ROOT_HOLDER=$USERS_DIR/root
USERS_MIN_PASSWORD=6
USERS_ADULT_GROUP=wheel
USERS_CHILD_GROUP=omarchy-child

users_say() {
  printf '%s\n' "$*" >&2
}

users_valid_name() {
  [[ $1 =~ ^[a-z_][a-z0-9_-]{0,31}$ ]]
}

# People's accounts: the UID range useradd gives them and a login shell.
users_accounts() {
  getent passwd | awk -F: '$3 >= 1000 && $3 < 60000 && $7 !~ /(nologin|false)$/ { print $1 }'
}

users_exists() {
  users_accounts | grep -qx -- "$1"
}

users_in_group() {
  id -nG -- "$1" 2>/dev/null | tr ' ' '\n' | grep -qx -- "$2"
}

users_role() {
  if users_in_group "$1" "$USERS_ADULT_GROUP"; then
    echo adult
  elif users_in_group "$1" "$USERS_CHILD_GROUP"; then
    echo child
  else
    echo limited
  fi
}

users_adults() {
  local user
  for user in $(users_accounts); do
    [[ $(users_role "$user") != "adult" ]] || echo "$user"
  done
}

users_shadow_hash() {
  awk -F: -v user="$1" '$1 == user { print $2; exit }' "$USERS_SHADOW"
}

# The hash travels in the environment, which only root can read for a root
# process, and the password on stdin.
users_password_matches_hash() {
  local password=$1 hash=$2
  [[ $hash == \$* ]] || return 1
  printf '%s' "$password" | USERS_HASH=$hash perl -e 'local $/; my $p = <STDIN>; my $h = $ENV{USERS_HASH}; exit(crypt($p, $h) eq $h ? 0 : 1)'
}

users_password_matches() {
  users_password_matches_hash "$1" "$(users_shadow_hash "$2")"
}

# Changes whenever the account's shadow password does, without holding it.
users_fingerprint() {
  users_shadow_hash "$1" | sha256sum | cut -c1-16
}

users_set_password() {
  printf '%s:%s\n' "$1" "$2" | chpasswd
}

# --- The system disk ---------------------------------------------------------

# The LUKS partition beneath /, or nothing when / is not encrypted. Fails when
# it cannot tell, as omarchy-drive-password does.
users_root_luks_device() {
  local root_source ancestry device
  root_source=$(findmnt -no SOURCE /) && [[ -n $root_source ]] || return 1
  ancestry=$(lsblk -nsrpo NAME,TYPE,FSTYPE "${root_source%%[*}") || return 1
  device=$(awk '$3 == "crypto_LUKS" { print $1; exit }' <<<"$ancestry")
  if [[ -n $device ]]; then
    readlink -f "$device"
  elif awk '$2 == "crypt" { found = 1 } END { exit !found }' <<<"$ancestry"; then
    return 1
  fi
}

# Platforms whose boot checks want every kept key slot recorded (Apple
# Silicon) cannot take a slot for another person until their boot package
# records one; adding it anyway would fail that check at the next boot.
users_slot_recorder_present() {
  local status=0
  "$USERS_LIFECYCLE_DISPATCH" --resolve luks-slots >/dev/null 2>&1 || status=$?
  (( status != 3 ))
}

# Sets USERS_DRIVE (empty when / is not encrypted) and USERS_UUID.
users_load_drive() {
  USERS_DRIVE=$(users_root_luks_device) || {
    users_say "Could not tell whether the system disk is encrypted."
    return 1
  }
  USERS_UUID=-
  if [[ -n $USERS_DRIVE ]]; then
    USERS_UUID=$(cryptsetup luksUUID "$USERS_DRIVE") && [[ -n $USERS_UUID ]] || {
      users_say "Could not read the system disk's UUID."
      return 1
    }
  fi
}

users_encrypted() {
  [[ -n ${USERS_DRIVE:-} ]]
}

# The slot the password opens. Returns 2 when it opens none. Tokens are tried
# before the key and report their own slot, so allow only a token type no token
# has.
users_slot_of() {
  local out status=0
  out=$(printf '%s' "$1" | LC_ALL=C cryptsetup open --test-passphrase --verbose --token-type passphrase-only --key-file - "$USERS_DRIVE" 2>&1) || status=$?
  (( status == 0 )) || return "$status"
  grep -o 'Key slot [0-9]* unlocked' <<<"$out" | grep -o '[0-9]*' | head -1
}

users_drive_slots() {
  cryptsetup luksDump "$USERS_DRIVE" | awk '
    /^[^ \t]/ { keyslots = ($0 == "Keyslots:") }
    keyslots && /^ +[0-9]+: luks2/ { sub(":", "", $1); print $1 }
    /^Key Slot [0-9]+: ENABLED/ { sub(":", "", $3); print $3 }' | paste -sd, -
}

users_slot_enabled() {
  [[ ,$(users_drive_slots), == *",$1,"* ]]
}

# Adds NEW in a free slot, authorised by CURRENT, and prints the new slot once
# NEW is proven to open it.
users_add_slot() {
  local current=$1 new=$2 slot
  local -a pbkdf=(--iter-time 2000)
  if cryptsetup isLuks --type luks2 "$USERS_DRIVE"; then
    pbkdf+=(--pbkdf argon2id)
  fi
  printf '%s\n%s' "$current" "$new" |
    bash -c 'IFS= read -r current; drive=$1; shift; exec cryptsetup luksAddKey -q "$@" --key-file <(printf "%s" "$current") "$drive" <(cat)' bash "$USERS_DRIVE" "${pbkdf[@]}" || return 1
  slot=$(users_slot_of "$new") || return 1
  [[ $slot =~ ^[0-9]+$ ]] || return 1
  echo "$slot"
}

# Batch mode needs no remaining key, so an interrupted change can be finished
# by a run that never saw the passwords.
users_kill_slot() {
  ! users_slot_enabled "$1" || cryptsetup luksKillSlot -q "$USERS_DRIVE" "$1"
}

# --- The slot map --------------------------------------------------------------

# One line per account: <LUKS UUID> <slot> <uid> <user> <shadow fingerprint>.

users_map_lines() {
  [[ -f $USERS_SLOT_MAP ]] && cat "$USERS_SLOT_MAP"
  true
}

users_map_field() {
  users_map_lines | awk -v user="$1" -v field="$2" '$4 == user { print $field; exit }'
}

users_map_slot() {
  users_map_field "$1" 2
}

users_map_user_for_slot() {
  users_map_lines | awk -v uuid="$1" -v slot="$2" '$1 == uuid && $2 == slot { print $4; exit }'
}

users_write_atomically() {
  local target=$1 tmp
  mkdir -p "${target%/*}" && chmod 700 "${target%/*}" || return 1
  tmp=$(mktemp "${target%/*}/.${target##*/}.XXXXXX") || return 1
  cat >"$tmp" && chmod 600 "$tmp" && mv -f "$tmp" "$target" || {
    rm -f "$tmp"
    return 1
  }
}

users_map_set() {
  local user=$1 slot=$2 uid
  uid=$(id -u -- "$user") || return 1
  { users_map_lines | awk -v user="$user" '$4 != user'
    printf '%s %s %s %s %s\n' "$USERS_UUID" "$slot" "$uid" "$user" "$(users_fingerprint "$user")"
  } | users_write_atomically "$USERS_SLOT_MAP"
}

users_map_remove() {
  users_map_lines | awk -v user="$1" '$4 != user' | users_write_atomically "$USERS_SLOT_MAP"
}

# The map is trusted only whole: every line for this disk, no slot or account
# twice, every account still there under its uid.
users_map_valid() {
  local uuid slot uid user fp
  local -A slots=() names=()
  while read -r uuid slot uid user fp; do
    [[ $uuid == "$USERS_UUID" && $slot =~ ^[0-9]+$ && -n $fp ]] || return 1
    [[ -z ${slots[$slot]:-} && -z ${names[$user]:-} ]] || return 1
    [[ $(id -u -- "$user" 2>/dev/null) == "$uid" ]] || return 1
    slots[$slot]=1
    names[$user]=1
  done < <(users_map_lines)
}

users_in_sync() {
  [[ -n $(users_map_slot "$1") && $(users_map_field "$1" 5) == "$(users_fingerprint "$1")" ]]
}

# --- The journal ---------------------------------------------------------------

# Records the operation, the account, slot numbers and the phase; never key
# material.

users_journal_get() {
  [[ -f $USERS_JOURNAL ]] || return 1
  awk -F= -v key="$1" '$1 == key { print substr($0, length(key) + 2); exit }' "$USERS_JOURNAL"
}

users_journal_put() {
  local key value
  local -A updates=()
  while (( $# )); do
    updates[$1]=$2
    shift 2
  done
  { if [[ -f $USERS_JOURNAL ]]; then
      while IFS='=' read -r key value; do
        [[ -n ${updates[$key]+set} ]] || printf '%s=%s\n' "$key" "$value"
      done <"$USERS_JOURNAL"
    fi
    for key in "${!updates[@]}"; do
      printf '%s=%s\n' "$key" "${updates[$key]}"
    done
  } | users_write_atomically "$USERS_JOURNAL"
}

users_journal_clear() {
  rm -f "$USERS_JOURNAL"
}

users_journal_pending() {
  [[ -f $USERS_JOURNAL ]]
}

# --- Root's password ---------------------------------------------------------

# Root's password is the installer owner's. The holder file names whose it is,
# so changing that person's password changes root's, and deleting them hands
# root to the adult who deleted them.

users_root_holder() {
  [[ -f $USERS_ROOT_HOLDER ]] && cat "$USERS_ROOT_HOLDER"
  true
}

users_set_root_holder() {
  printf '%s\n' "$1" | users_write_atomically "$USERS_ROOT_HOLDER"
}

# The first change records the caller as root's holder when root's password is
# theirs.
users_adopt_root_holder() {
  local caller=$1 password=$2
  [[ -z $(users_root_holder) ]] || return 0
  if users_password_matches_hash "$password" "$(users_shadow_hash root)"; then
    users_set_root_holder "$caller"
  fi
}

# --- Rules ---------------------------------------------------------------------

users_ensure_wheel_grant() {
  local file=$USERS_SUDOERS_DIR/00-omarchy-wheel
  [[ ! -f $file ]] || return 0
  echo "%wheel ALL=(ALL:ALL) ALL" >"$file.tmp" && chmod 440 "$file.tmp" && mv -f "$file.tmp" "$file"
}

# Every password is a disk key and picks its account, so it must be long
# enough and nobody else's: no other account's login password, and no other
# key slot on the disk (an old password left in a slot no longer matches any
# hash but still opens it). EXCEPT_USER and EXCEPT_SLOT are the ones being
# replaced.
users_check_new_password() {
  local password=$1 except_user=$2 except_slot=$3 user slot status=0
  if [[ $password == *$'\n'* ]]; then
    users_say "A password can't contain a line break."
    return 1
  elif (( ${#password} < USERS_MIN_PASSWORD )); then
    users_say "The password must be at least $USERS_MIN_PASSWORD characters."
    return 1
  fi
  for user in $(users_accounts); do
    [[ $user != "$except_user" ]] || continue
    if users_password_matches "$password" "$user"; then
      users_refuse_taken
      return 1
    fi
  done
  if users_encrypted; then
    slot=$(users_slot_of "$password") || status=$?
    if (( status == 0 )) && [[ $slot != "$except_slot" ]]; then
      users_refuse_taken
      return 1
    elif (( status != 0 && status != 2 )); then
      users_say "Could not check the password against the system disk."
      return 1
    fi
  fi
}

# Saying a password is taken says it is somebody's. The disk prompt says as
# much at every boot, so the delay only keeps this from being any cheaper.
users_refuse_taken() {
  sleep "$USERS_REFUSAL_DELAY"
  users_say "Another user already has this password. Choose a different one."
}

# The caller's own password, proving they are who sudo says. On an encrypted
# disk it must open their mapped slot; the first time, before the map knows
# them, the slot it opens becomes theirs if nobody else holds it. Sets
# USERS_CALLER_SLOT.
users_authenticate() {
  local caller=$1 password=$2 mapped slot status=0 holder
  USERS_CALLER_SLOT=-
  if ! users_password_matches "$password" "$caller"; then
    sleep "$USERS_REFUSAL_DELAY"
    users_say "That isn't $caller's password."
    return 1
  fi
  users_encrypted || return 0
  slot=$(users_slot_of "$password") || status=$?
  if (( status == 2 )); then
    users_say "$caller's password doesn't open the system disk. Change it under Setup > Users first."
    return 1
  elif (( status != 0 )); then
    users_say "Could not check the password against the system disk."
    return 1
  fi
  mapped=$(users_map_slot "$caller")
  if [[ -n $mapped && $mapped != "$slot" ]]; then
    users_say "$caller's password opens a different key slot than the one recorded for them."
    return 1
  fi
  holder=$(users_map_user_for_slot "$USERS_UUID" "$slot")
  if [[ -n $holder && $holder != "$caller" ]]; then
    users_say "$caller's password opens $holder's key slot."
    return 1
  fi
  [[ -n $mapped ]] || users_map_set "$caller" "$slot" || return 1
  USERS_CALLER_SLOT=$slot
}

users_require_adult() {
  if [[ $(users_role "$1") != "adult" ]]; then
    users_say "Only a grown-up's account can do that."
    return 1
  fi
}

# --- Operations ----------------------------------------------------------------

# Each operation journals its phase after every step, keeping old access until
# its replacement is proven, so users_finish can roll an interrupted one back
# (before the new password is in place everywhere) or forward (after).

users_add() {
  local caller=$1 role=$2 name=$3 password=$4 caller_password=$5 slot groups
  if ! users_valid_name "$name"; then
    users_say "Use lowercase letters, digits, - and _ for the name, starting with a letter."
    return 1
  elif getent passwd "$name" >/dev/null || getent group "$name" >/dev/null; then
    users_say "There is already a user or group named $name."
    return 1
  fi
  case $role in
    adult) groups=$USERS_ADULT_GROUP ;;
    child) groups=$USERS_CHILD_GROUP ;;
    *) users_say "A user is an adult or a child."; return 1 ;;
  esac
  if users_encrypted && users_slot_recorder_present; then
    users_say "This machine's boot checks can't take a second person's disk password yet."
    return 1
  fi
  users_authenticate "$caller" "$caller_password" || return 1
  users_require_adult "$caller" || return 1
  users_check_new_password "$password" "" "" || return 1
  users_adopt_root_holder "$caller" "$caller_password" || return 1
  users_ensure_wheel_grant || return 1
  getent group "$groups" >/dev/null || groupadd -r "$groups" || return 1

  users_journal_put op add user "$name" phase start || return 1
  useradd -m -G "$groups" -s /bin/bash "$name" || { users_journal_clear; return 1; }
  users_journal_put phase account || return 1
  if users_encrypted; then
    slot=$(users_add_slot "$caller_password" "$password") || {
      users_say "Could not add $name's password to the system disk."
      users_finish
      return 1
    }
    users_journal_put slot "$slot" phase slot || return 1
  fi
  users_set_password "$name" "$password" || { users_finish; return 1; }
  users_journal_put phase shadow || return 1
  users_finish
}

users_password() {
  local caller=$1 name=$2 password=$3 caller_password=$4 old_slot="" slot
  users_exists "$name" || { users_say "There is no user named $name."; return 1; }
  users_authenticate "$caller" "$caller_password" || return 1
  if [[ $name != "$caller" ]]; then
    users_require_adult "$caller" || return 1
  fi
  if users_password_matches "$password" "$name"; then
    users_say "That's already $name's password."
    return 1
  fi
  if users_password_matches "$password" "$name"; then
    users_say "That's already $name's password."
    return 1
  fi
  if users_encrypted; then
    old_slot=$(users_map_slot "$name")
  fi
  users_check_new_password "$password" "$name" "$old_slot" || return 1
  users_adopt_root_holder "$caller" "$caller_password" || return 1

  users_journal_put op password user "$name" old_slot "${old_slot:--}" phase start || return 1
  if users_encrypted; then
    slot=$(users_add_slot "$caller_password" "$password") || {
      users_say "Could not add the new password to the system disk."
      users_finish
      return 1
    }
    users_journal_put slot "$slot" phase slot || return 1
  fi
  users_set_password "$name" "$password" || { users_finish; return 1; }
  if [[ $(users_root_holder) == "$name" ]]; then
    users_set_password root "$password" || { users_finish; return 1; }
  fi
  users_journal_put phase shadow || return 1
  users_finish
}

users_delete() {
  local caller=$1 name=$2 caller_password=$3 delete_home=$4 adults
  users_exists "$name" || { users_say "There is no user named $name."; return 1; }
  users_authenticate "$caller" "$caller_password" || return 1
  users_require_adult "$caller" || return 1
  if [[ $name == "$caller" ]]; then
    users_say "You can't delete the account you're signed in as."
    return 1
  fi
  adults=$(users_adults | grep -cvx -- "$name" || true)
  if (( adults == 0 )); then
    users_say "$name is the last grown-up's account, and someone must be able to look after this computer."
    return 1
  fi
  users_adopt_root_holder "$caller" "$caller_password" || return 1

  users_journal_put op delete user "$name" uid "$(id -u -- "$name")" slot "$(users_map_slot "$name")" home "$delete_home" phase start || return 1
  # A root holder handed over before anything is removed, so root never keeps
  # a deleted person's password.
  if [[ $(users_root_holder) == "$name" ]]; then
    users_set_password root "$caller_password" && users_set_root_holder "$caller" || return 1
  fi
  loginctl terminate-user "$name" 2>/dev/null || true
  users_map_remove "$name" || return 1
  users_journal_put phase unmapped || return 1
  users_finish
}

# Finishes whatever the journal says was under way, and succeeds once nothing
# is.
users_finish() {
  local op user slot old_slot phase uid
  users_journal_pending || return 0
  op=$(users_journal_get op)
  user=$(users_journal_get user)
  slot=$(users_journal_get slot)
  old_slot=$(users_journal_get old_slot)
  phase=$(users_journal_get phase)

  case $op:$phase in
    add:start)
      users_journal_clear
      ;;
    add:account | add:slot)
      if [[ -n $slot ]] && users_encrypted; then
        users_kill_slot "$slot" || return 1
      fi
      userdel -r "$user" 2>/dev/null || ! getent passwd "$user" >/dev/null || return 1
      users_journal_clear
      ;;
    add:shadow)
      if users_encrypted; then
        users_map_set "$user" "$slot" || return 1
      fi
      users_journal_clear
      ;;
    password:start)
      users_journal_clear
      ;;
    password:slot)
      # The new password reached the disk but not the account: back to the old.
      if [[ -n $slot ]] && users_encrypted; then
        users_kill_slot "$slot" || return 1
      fi
      users_journal_clear
      ;;
    password:shadow)
      if users_encrypted; then
        users_map_set "$user" "$slot" || return 1
        if [[ $old_slot != "-" && $old_slot != "$slot" ]]; then
          users_kill_slot "$old_slot" || return 1
        fi
      fi
      users_journal_clear
      ;;
    delete:start)
      users_journal_clear
      ;;
    delete:unmapped)
      if [[ -n $slot ]] && users_encrypted; then
        users_kill_slot "$slot" || return 1
      fi
      uid=$(users_journal_get uid)
      if [[ $uid =~ ^[0-9]+$ ]]; then
        rm -f "$USERS_SUDOERS_DIR/99-omarchy-nopasswd-$uid" "$USERS_SUDOERS_DIR/99-omarchy-permanent-nopasswd-$uid"
      fi
      if getent passwd "$user" >/dev/null; then
        if [[ $(users_journal_get home) == "yes" ]]; then
          userdel -r "$user" || return 1
        else
          userdel "$user" || return 1
        fi
      fi
      users_journal_clear
      ;;
    *)
      users_say "The users journal records an unknown change ($op, $phase)."
      return 1
      ;;
  esac
}

# --- Listing -------------------------------------------------------------------

# user role sync, one per line; sync is "yes", "no", or "-" on an unencrypted
# disk.
users_list() {
  local user sync
  for user in $(users_accounts); do
    sync=-
    if users_encrypted; then
      if users_in_sync "$user"; then sync=yes; else sync=no; fi
    fi
    printf '%s %s %s\n' "$user" "$(users_role "$user")" "$sync"
  done
}
