#!/bin/bash

# omarchy:summary=Change a person's password, which also unlocks the disk
# omarchy:args=[NAME]
# omarchy:requires-sudo=true

set -euo pipefail
set +x

source "$OMARCHY_PATH/install/helpers/user-prompts.sh"
user_refuse_root

me=$(id -un)
name=${1:-$me}

if [[ $name == "$me" ]]; then
  current=$(gum input --password --header "$(omarchy-i18n users.currentPassword)") || exit 1
  password=$(user_prompt_new_password "$(omarchy-i18n users.newPassword)") || exit 1
  if [[ " $(id -nG) " == *" omarchy-child "* ]]; then
    # A child's grant reaches only password-self, and asks for no sudo password.
    printf '%s\n%s\n' "$current" "$password" | sudo -n omarchy-user-helper password-self
  else
    printf '%s\n' "$current" | sudo -S -p '' -v 2>/dev/null || { echo "$(omarchy-i18n users.wrongPassword)" >&2; exit 1; }
    printf '%s\n%s\n' "$current" "$password" | sudo omarchy-user-helper password "$name"
  fi
else
  password=$(user_prompt_new_password "$(omarchy-i18n users.newPasswordFor "$name")") || exit 1
  mine=$(user_prompt_own_password "$(omarchy-i18n users.yourPassword)") || exit 1
  printf '%s\n%s\n' "$mine" "$password" | sudo omarchy-user-helper password "$name"
fi
echo "$(omarchy-i18n users.passwordChanged "$name")"
